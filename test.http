### Get user's task

GET {{baseUrl}}/tasks
Authorization: Bearer {{token}}
Content-Type: application/json

### Get user's task unauthorized

GET {{baseUrl}}/tasks
Authorization: Bearer notAToken
Content-Type: application/json

### See a user's task

GET {{baseUrl}}/tasks/{{taskId}}
Authorization: Bearer {{token}}
Content-Type: application/json

### See a user's: task unauthorized

GET http://localhost:3000/tasks/a6a0de01-514d-474d-99a6-076bb69d852d
Authorization: Bearer notAtoken
Content-Type: application/json

### See a user's: task not found

GET http://localhost:3000/tasks/1234
Authorization: Bearer {{token}}
Content-Type: application/json

### Edit a user's task 
PUT http://localhost:3000/tasks/{{taskId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "This is test",
  "description": "This is a test to update a task that should be authorized by the backend"
}

### Edit a user's task: bad input
PUT http://localhost:3000/tasks/{{taskId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "This is test",
  "dueDate": "2025-01-10",
  "description": "This is a test to update a task that should be authorized by the backend"
}

### Edit a user's task: unauthorized
PUT http://localhost:3000/tasks/{{taskId}}
Authorization: Bearer notAToken
Content-Type: application/json

{
  "title": "This is a updated  task",
  "description": "This is a test to update a task that should NOT be authorized by the backend"
}

### Edit a user's task: not found
PUT http://localhost:3000/tasks/notAnId
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "This is a updated  task",
  "description": "This is a test to update a task that should be authorized by the backend"
}

